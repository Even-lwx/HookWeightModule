# --- Keil MDK-ARM build artifacts ---

# Build output directory (all .o/.d/.crf/.axf/.hex/.map/.lnp/.htm/.sct/.dep)
/MDK-ARM/STM32G031C8T6/

# Listing files
/MDK-ARM/*.lst

# User-specific GUI layout & options (machine-specific, regenerated by Keil)
/MDK-ARM/*.uvguix.*
/MDK-ARM/*.uvoptx

# Auto-generated RTE components (regenerated by Keil on project load)
/MDK-ARM/RTE/

# Debug configuration
/MDK-ARM/DebugConfig/

# --- STM32CubeMX ---

# CubeMX internal temp/cache file (regenerated automatically)
/.mxproject

# --- Common editor/OS noise ---
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini